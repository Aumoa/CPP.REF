<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<Type Name="Ayla::Vector&lt;*,*&gt;">
		<DisplayString>{{Count={Size()}}}</DisplayString>
		<Expand>
			<Item Name="[Count]">Size()</Item>
			<ArrayItems>
				<Size>Size()</Size>
				<ValuePointer>Scalars</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>
	<Type Name="Ayla::Vector&lt;*,2&gt;">
		<DisplayString>{{X={X,g} Y={Y,g}}}</DisplayString>
		<Expand>
			<Item Name="[Count]">2</Item>
			<Item Name="[Size]">X*Y</Item>
			<ArrayItems>
				<Size>2</Size>
				<ValuePointer>Scalars</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>
	<Type Name="Ayla::Vector&lt;*,3&gt;">
		<DisplayString>{{X={X,g} Y={Y,g} Z={Z,g}}}</DisplayString>
		<Expand>
			<Item Name="[Count]">3</Item>
			<Item Name="[Size]">X*Y*Z</Item>
			<ArrayItems>
				<Size>3</Size>
				<ValuePointer>Scalars</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>
	<Type Name="Ayla::Vector&lt;*,4&gt;">
		<DisplayString>{{X={X,g} Y={Y,g} Z={Z,g}, W={W,g}}}</DisplayString>
		<Expand>
			<Item Name="[Count]">4</Item>
			<Item Name="[Size]">X*Y*Z*W</Item>
			<ArrayItems>
				<Size>4</Size>
				<ValuePointer>Scalars</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>
	<Type Name="Ayla::Quaternion&lt;*&gt;">
		<DisplayString>{{X={V.X,g} Y={V.Y,g} Z={V.Z,g} W={W,g}}}</DisplayString>
		<Expand>
			<Item Name="[Count]">4</Item>
			<ArrayItems>
				<Size>4</Size>
				<ValuePointer>V.Scalars</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>
</AutoVisualizer>